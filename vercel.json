{
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "headers": [
        {
            "source": "/editor",
            "headers": [
                { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
                { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
            ]
        },
        {
            "source": "/editor.html",
            "headers": [
                { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
                { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
            ]
        },
        {
            "source": "/assets/(.*)",
            "headers": [
                { "key": "Cross-Origin-Resource-Policy", "value": "cross-origin" }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/editor",
            "destination": "/editor.html"
        },
        {
            "source": "/docs",
            "destination": "/pages/docs.html"
        },
        {
            "source": "/tutorials",
            "destination": "/pages/tutorials.html"
        },
        {
            "source": "/blog",
            "destination": "/pages/blog.html"
        },
        {
            "source": "/changelog",
            "destination": "/pages/changelog.html"
        },
        {
            "source": "/about",
            "destination": "/pages/about.html"
        },
        {
            "source": "/careers",
            "destination": "/pages/careers.html"
        },
        {
            "source": "/contribute",
            "destination": "/pages/contribute.html"
        },
        {
            "source": "/feedback",
            "destination": "/pages/feedback.html"
        },
        {
            "source": "/privacy",
            "destination": "/pages/privacy.html"
        },
        {
            "source": "/terms",
            "destination": "/pages/terms.html"
        }
    ]
}